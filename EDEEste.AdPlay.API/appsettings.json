{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdPlay": ""
  },
  "BaseDatos": {
    "AplicarMigracionesAlIniciar": false
  },
  "Almacenamiento": {
    "RutaRaiz": "App_Data/Almacenamiento"
  },
  "Multimedia": {
    "TamanoMaximoImagenMb": 20,
    "TamanoMaximoVideoMb": 500
  },
  "Reproductor": {
    "IntervaloConsultaSegundos": 30,
    "IntervalosParaDesconexion": 3
  },
  "Cors": {
    "OrigenesPermitidos": []
  },
  "Seguridad": {
    "DuracionAccesoMinutos": 30,
    "DuracionRenovacionHoras": 12,
    "IntentosInicioSesionPorMinuto": 10,
    "InicializarAlIniciar": false
  }
}
